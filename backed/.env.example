# ================= 大模型配置 =================
# 复制本文件为 .env 后填入你自己的密钥；.env 已被 .gitignore 忽略
#
# ⚠️ Key 必须与 BASE_URL 属于同一家平台，否则会返回 401 "Token is invalid"：
#   · DeepSeek 官方平台（platform.deepseek.com）：Key 形如 sk-<32位十六进制>
#         LLM_BASE_URL=https://api.deepseek.com
#         LLM_MODEL=deepseek-chat
#   · 硅基流动 SiliconFlow（siliconflow.cn）：Key 形如 sk-<48位字母数字>
#         LLM_BASE_URL=https://api.siliconflow.cn
#         LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro
# 只要服务是 OpenAI 兼容的 /v1/chat/completions，换哪家都行。
LLM_API_KEY=sk-你的密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ================= 高德开放平台（Web 服务 Key）=================
# 控制台 → 应用管理 → 添加 Key → 服务平台选「Web服务」
# 留空则走降级模式（enhanced=false）
AMAP_KEY=
AMAP_BASE=https://restapi.amap.com/v3

# ================= 缓存 TTL（秒）=================
POI_CACHE_TTL=86400
MATRIX_CACHE_TTL=604800

# ================= 服务端口 =================
PORT=8080

# ================= 数据库（SQLite）=================
# 默认 backed/data/app.db，首次启动自动建表
DB_PATH=

# ================= 登录态 =================
# 登录 token 有效期（天）
TOKEN_TTL_DAYS=30

# ================= 短信验证码 =================
# dev = 开发/模拟模式：不真发短信，验证码打印到后端日志
# 接入真实短信只需新增 provider 实现（见 app/sms.py），无需改动业务代码
SMS_PROVIDER=dev
# 验证码有效期（秒）
SMS_CODE_TTL=300
# 同一手机号两次发送的最小间隔（秒）
SMS_SEND_INTERVAL=60
# 同一手机号每小时最多发送次数
SMS_HOURLY_LIMIT=10
# dev 模式下是否把验证码回显到接口响应（仅本地调试，生产必须 false）
SMS_DEBUG_ECHO=true
# ================= 图片地标识别（可选）=================
# 不填则 /api/vision/recognize 降级返回 degraded=true，前端提示手动输入。
#
# ⚠️ 只有 **deepseek-flash** 支持图像理解；deepseek-v4-pro 会明确回答
#    "我无法查看这张照片"。若要换别的视觉模型，任何 OpenAI 兼容的
#    /chat/completions 都行（如 Qwen-VL、GLM-4V）。
#
# 留空 VISION_API_KEY 时会复用 LLM_API_KEY 与 LLM_BASE_URL。
VISION_API_KEY=
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-flash
# 思考模型较慢，超时要给足
VISION_TIMEOUT=90
# 单张图上限（字节），8MB 足够手机直出
VISION_MAX_BYTES=8388608
